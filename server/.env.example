# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://nasec:nasec_dev_pw@localhost:5432/nasec_erp

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookies (set SECURE_COOKIES=true behind HTTPS)
SECURE_COOKIES=false
COOKIE_DOMAIN=

# File storage: "local" or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/files

# AWS S3 (used when STORAGE_DRIVER=s3)
AWS_REGION=me-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=no-reply@nasec.local

# UAE E-Invoicing / ASP
# Keep ASP secrets on the API server only. The frontend receives only configured/not-configured status.
EINVOICE_ASP_MODE=simulation
EINVOICE_ASP_PROVIDER=
EINVOICE_ASP_ENDPOINT=
EINVOICE_ASP_API_KEY=
EINVOICE_WEBHOOK_SECRET=

# Initial director user (created by seed:initial)
SEED_DIRECTOR_EMAIL=director@nasec.local
SEED_DIRECTOR_PASSWORD=ChangeMe!123
SEED_DIRECTOR_NAME=Director
