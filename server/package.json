{
  "name": "@nasec/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:initial": "tsx src/seed/initial.ts",
    "seed:staff": "tsx src/seed/staff.ts",
    "seed:docs": "tsx src/seed/docs.ts",
    "seed:import": "tsx src/seed/from-localstorage.ts",
    "import:firebase-attendance": "npx tsx src/integrations/firebase-attendance.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "bcrypt": "^5.1.1",
    "firebase-admin": "^12.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "socket.io": "^4.8.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "resend": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^2.1.4"
  }
}
