# Copy to `.env` on the production server (NEVER commit the real .env).
#   cp .env.production.example .env
#   nano .env       # fill in real secrets

# --- Database ---
POSTGRES_USER=nasec
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=nasec_erp

# --- API secrets ---
# Generate with:  openssl rand -base64 48 | tr -d '\n='
JWT_SECRET=CHANGE-ME-paste-output-of-openssl-rand
JWT_REFRESH_SECRET=CHANGE-ME-different-second-secret

# --- CORS / cookies ---
# The browser origin(s) allowed to call the API. Comma-separated.
# When users hit http://<server-ip>, the origin is http://<server-ip>.
# When you point a real domain at it, change to https://erp.nasec.com etc.
CORS_ORIGINS=http://localhost,http://YOUR_SERVER_IP
# SECURE_COOKIES: set true behind HTTPS
SECURE_COOKIES=false
# COOKIE_DOMAIN: leave blank for IP/localhost; set .nasec.com with a real domain
COOKIE_DOMAIN=

# --- Public port ---
# PUBLIC_HTTP_PORT: change to 8080 if 80 is taken on the host
PUBLIC_HTTP_PORT=80

# --- Storage ---
# local  = bytes in the api_files docker volume (default; survives container rebuilds)
# s3     = AWS S3 bucket. Set the AWS_* vars below.
STORAGE_DRIVER=local
AWS_REGION=me-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=no-reply@nasec.local

# --- UAE E-Invoicing / ASP ---
# Use simulation until the accredited service provider supplies live credentials.
EINVOICE_ASP_MODE=simulation
EINVOICE_ASP_PROVIDER=
EINVOICE_ASP_ENDPOINT=
EINVOICE_ASP_API_KEY=
EINVOICE_WEBHOOK_SECRET=

# --- Initial director (first-time seed) ---
SEED_DIRECTOR_EMAIL=director@nasec.local
SEED_DIRECTOR_PASSWORD=CHANGE-ME-temporary-password
SEED_DIRECTOR_NAME=Director

# --- Logging ---
LOG_LEVEL=info

# --- Firebase RTDB attendance import ---
# Place the (rotated) service-account JSON at ./secrets/firebase.json (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase.json
# RTDB URL — usually https://<project>-default-rtdb.firebaseio.com (set your region if different)
FIREBASE_DB_URL=https://nasecattapp-default-rtdb.firebaseio.com
# RTDB node holding attendance records
FIREBASE_ATTENDANCE_PATH=attendance
# Set true to enable the 15-min scheduled sync
FIREBASE_SYNC_ENABLED=false
